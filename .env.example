# ── 基础服务 ──
PORT=3333
BIND_HOST=127.0.0.1
AUTH_MODE=local
ENABLE_DEMO_PROVIDER=true
# 默认优先 Google Gemini；Google 未配置时选择免费演示（若已启用）。
# IMAGE_GENERATION_PROVIDER=google
# ALLOW_SERVER_SIDE_IMPORT=false
# 可选：外部 Agent 接入，填写随机令牌，不等同于提供商 API Key。
# BANANA_GALLERY_API_TOKEN=

# 可选：Cloudflare Access 远程入口，仍保留本机免登入口。
# AUTH_MODE=cloudflare_access
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUDIENCE=
# AUTH_ALLOWED_EMAILS=
# REMOTE_ACCESS_PORT=3334

# ── 主推渠道：Google Gemini ──
# 方式一：Gemini Developer API
GEMINI_API_KEY=

# 方式二：Vertex AI 服务账号 JSON；两种方式都填写时，优先使用服务账号。
# 二选一填写 JSON 的路径，不要把 JSON 内容填在这里。
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# BANANA_GALLERY_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# 留空时读取服务账号 JSON 的 project_id；location 默认 global。
# GOOGLE_CLOUD_LOCATION=global

# ── 主推渠道：OpenAI / 自定义中转站 ──
OPENAI_IMAGE_API_KEY=
# 填写 API 根地址（含服务所需的版本前缀，例如 /v1），不含 /images。
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# ── 进阶渠道（可选；未配置则不启用）──
# Seedream
# VOLCENGINE_DOUBAO_API_KEY=

# DashScope（Qwen / Kling 共用 API Key）
# DASHSCOPE_API_KEY=
# QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# KLING_IMAGE_MODEL=kling/kling-v3-omni-image-generation

# ComfyUI（自管 Qwen / Krea GPU 服务）
# QWEN_LOCAL_SSH_HOST=comfyui-host
# QWEN_LOCAL_REMOTE_PORT=8188
# QWEN_LOCAL_START_CMD=
# QWEN_LOCAL_GPU_PATTERN=
# QWEN_LOCAL_UNET=
# 可选：显式指定自管的远端结果找回及清理助手命令。
# QWEN_LOCAL_OUTPUT_HELPER_CMD=
